PORT=3000
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=postgres

# --- Overpass (mirrors y timeouts) ---
OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OVERPASS_PING_TIMEOUT_MS=4000      # ms para "pre-ping" de mirrors
OVERPASS_MIRROR_TTL_MS=600000      # ms que cacheamos el mirror sano (10 min)
OSM_OVERPASS_TIMEOUT=90            # seg para la consulta Overpass

# --- Cache de resultados en memoria ---
CACHE_TTL_SEC=600                  # seg (10 min)

SOCIALACCOUNT_OIDC_CERTS=https://certs.com
SOCIALACCOUNT_OIDC_ID_TOKEN_ISSUER=https://token_issuer.com

SMTP_HOST=smtp.host.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@user
SMTP_PASS=pass
SMTP_FROM_NAME="User"
SMTP_FROM_EMAIL=noreply@user
